# ============================================================
# TAP Backend — Environment Variables
# Copy to .env and fill in real values. NEVER commit .env.
# ============================================================

# --- Supabase (NEW — primary DB + auth) ---------------------
# Dashboard → Settings → API
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Database connection strings (Dashboard → Connect)
# port 6543 = connection pooler (runtime), 5432 = direct (migrations)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.<your-project-ref>.supabase.co:6543/postgres
DIRECT_URL=postgresql://postgres:YOUR_PASSWORD@db.<your-project-ref>.supabase.co:5432/postgres

# --- Firebase (LEGACY — used until Supabase cutover) --------
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=

# --- Legacy JWT auth (until cutover) ------------------------
JWT_SECRET=change-me
COOKIE_SECRET=change-me

# --- AWS (LEGACY — S3 resume storage + SES email) -----------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=

# --- Firebase Admin SDK (LEGACY — bulk ops) -----------------
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
